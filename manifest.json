{
  "manifest_version": 3,
  "name": "MTX Classic Look",
  "version": "1.3.0",
  "description": "Restores the pre-5.2 Nilear MTX layout for the Tickets list, the ticket summary and Work on Ticket. Alt+Shift+C turns it on and off.",
  "author": "Clearbridge Business Solutions",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mtx-classic@clearbridge.ca",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://mtx.nilear.com/*",
        "https://app.nilear.com/*"
      ],
      "js": [
        "mtx-classic.user.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
